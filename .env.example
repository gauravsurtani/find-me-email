# Copy to .env and fill in. Never commit .env.

# Apify token — required for find_emails.py (harvestapi actor).
# Get one at https://apify.com (the FREE plan works — first 1000+ profile
# lookups via harvestapi cost ~$10 and pay-per-result means you only burn
# credits on successful lookups).
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxx

# SignalHire API key — required for find_emails_signalhire.py and the
# enrich.py cascade. Used as the second-stage provider for personal-email
# recovery on URLs harvestapi missed. Get one at https://signalhire.com/api
# (Emails plan: $57/mo for 1000 credits ≈ $0.06/lookup).
SIGNALHIRE_API_KEY=
