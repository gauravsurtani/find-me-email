# Copy to .env and fill in. Never commit .env.
# Apify (Phase 1, required)
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Hunter.io (optional, used for .edu pattern verification fallback)
HUNTER_API_KEY=

# Exa (optional, future provider)
EXA_API_KEY=

# Apollo (optional, future provider)
APOLLO_API_KEY=

# GitHub (recommended for github_email_leak provider). Without a token,
# you get 60 API calls/hr; with one, 5000/hr. Any token works — even a
# fine-grained PAT with no permissions gives you the higher limit.
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=

# Budget guardrail in USD; the orchestrator stops if cumulative cost would exceed this.
BUDGET_USD=100
